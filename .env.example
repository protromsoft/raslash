EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxx
# Must match RevenueCat entitlement id (default: pro)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=pro
# Keep false until App Store / Play products and RevenueCat offerings are live.
EXPO_PUBLIC_ENABLE_PAYWALL=false
# Enable only after the database migration and Edge Functions are deployed.
EXPO_PUBLIC_ENABLE_CHECKIN_CREDITS=false
EXPO_PUBLIC_SUPPORT_EMAIL=

# Public crash-report endpoint. Do not put a Sentry auth token here.
EXPO_PUBLIC_SENTRY_DSN=

# Android Maps SDK key for standalone APK/AAB builds. Create a Google Cloud
# Android-restricted key (com.raslash.app + each signing SHA-1), enable Maps SDK
# for Android, then add it as a *sensitive* EAS variable in the build environment.
# This is embedded in the Android binary, so do not reuse the server Places key.
GOOGLE_MAPS_ANDROID_API_KEY=

# EAS build-only Sentry source-map settings. Store SENTRY_AUTH_TOKEN as a
# sensitive EAS environment variable; never commit its value.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Server-only secrets: set with `supabase secrets set`, never expose as EXPO_PUBLIC_*.
GOOGLE_PLACES_API_KEY=
REVENUECAT_API_KEY=
REVENUECAT_WEBHOOK_SECRET=
# Optional for the local maintenance script only (never commit).
# SUPABASE_SERVICE_ROLE_KEY=
